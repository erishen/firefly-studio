{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Main Process (Electron)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "runtimeExecutable": "${workspaceFolder}/node_modules/.bin/electron-vite",
      "runtimeArgs": ["dev"],
      "console": "integratedTerminal",
      "autoAttachChildProcesses": true,
      "sourceMaps": true
    },
    {
      "name": "Debug C++ Native (lldb attach)",
      "type": "lldb",
      "request": "attach",
      "pid": "${command:pickProcess}",
      "program": "${workspaceFolder}/node_modules/electron/dist/Electron.app/Contents/MacOS/Electron",
      "sourceMap": {
        "/": "${workspaceFolder}/native/src"
      }
    }
  ]
}
