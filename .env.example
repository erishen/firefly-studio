# ============================================================
# Firefly Studio 配置
# 复制本文件为 .env 并填入实际值
# ============================================================

# ---- LLM 配置（内置后端 /api/chat 使用）----
# 支持任意 OpenAI 兼容接口（OpenAI / DeepSeek / 本地 Ollama 等）
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2048

# 也兼容 OPENAI_ 前缀（与 resolve-studio 一致）
# OPENAI_API_KEY=your-api-key-here
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# ---- 内置后端端口（可选，默认 8788）----
# SERVER_PORT=8788
# SERVER_HOST=127.0.0.1

# ---- C++ 原生模块（可选，通常不需要改）----
# NATIVE_MODULE_PATH=native/build/Release/qt_native.node

# ---- TTS 语音合成配置 ----
# TTS_PROVIDER: piper (本地离线，默认) | edge-tts (仅本地可用，需自行准备实现文件)
TTS_PROVIDER=piper

# ---- Piper 配置（本地离线，默认）----
# Piper 模型路径（仅 TTS_PROVIDER=piper 时生效）
# 中文模型: zh_CN-xiao_ya-medium.onnx (小雅，默认，标点停顿更好)
# 英文模型: en_US-amy-medium.onnx (Amy，默认)
PIPER_ZH_MODEL=native/piper/models/zh_CN-xiao_ya-medium.onnx
PIPER_EN_MODEL=native/piper/models/en_US-amy-medium.onnx

# ---- edge-tts 配置（仅本地可用，GitHub 版本不包含实现文件）----
ENABLE_EDGE_TTS=false
EDGE_TTS_VOICE=zh-CN-XiaoxiaoNeural
# EDGE_TTS_PYTHON=/usr/bin/python3
# EDGE_TTS_PYTHONPATH=/path/to/python/site-packages
# FFMPEG_PATH=/opt/homebrew/bin/ffmpeg

# ---- VRM 模型配置（可选）----
# 萤火女仆 VRM 模型的生产环境 URL（仅生产环境使用，开发环境使用本地 public/ 下的模型）
# 注意：该 VRM 模型许可证为 OnlyAuthor + redistribution=disallow，请勿公开分发裸链
# FIREFLY_VRM_PROD_URL=https://your-domain.com/path/to/fireflyMaid.vrm
